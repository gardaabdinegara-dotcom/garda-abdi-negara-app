# Salin menjadi .env.local lalu isi. File .env.local tidak boleh masuk Git.

# "sheets" untuk Google Sheets, "lokal" untuk pengembangan di komputer sendiri (data di .data/lokal.json).
# Bila dikosongkan: "sheets" kalau GOOGLE_SERVICE_ACCOUNT_JSON terisi, selain itu "lokal" (hanya saat development).
DATA_MODE=

# Seluruh isi file JSON service account (satu baris). Jangan simpan file kuncinya di dalam folder proyek.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternatif untuk komputer sendiri: alamat file kunci JSON di LUAR folder proyek (tidak berlaku di Vercel).
GOOGLE_SERVICE_ACCOUNT_FILE=

# ID spreadsheet (bagian di antara /d/ dan /edit pada alamatnya).
# Untuk spreadsheet latihan, isi keduanya dengan ID yang sama.
SHEET_ID_INTI=
SHEET_ID_KEUANGAN=

# Secret acak minimal 32 karakter untuk menandatangani sesi. Contoh pembuatan:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Redis Upstash (paket gratis cukup). Dipakai untuk antrean penyimpanan dan batas percobaan login.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Zona waktu operasional
APP_TIMEZONE=Asia/Jakarta
